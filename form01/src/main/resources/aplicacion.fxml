<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox id="root" alignment="TOP_CENTER" spacing="20.0" stylesheets="@aplicacion.css" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="jmb.juanma.form01.views.AplicacionView">
    <children>
        <TextField fx:id="numero" alignment="CENTER_RIGHT" prefHeight="25.0" text="1">
            <VBox.margin>
                <Insets left="20.0" right="20.0" top="20.0"/>
            </VBox.margin>
        </TextField>
        <Button fx:id="duplicar" focusTraversable="false" prefHeight="30.0" prefWidth="130.0" text="_Duplicar">
            <VBox.margin>
                <Insets/>
            </VBox.margin>
        </Button>
        <TextField fx:id="estado" focusTraversable="false" prefHeight="25.0" prefWidth="260.0"
                   text="Comienza la aplicación"/>
    </children>
</VBox>